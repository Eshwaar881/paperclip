{
  "version": 2,
  "framework": "vite",
  "buildCommand": "pnpm --filter @paperclipai/shared build && pnpm --filter @paperclipai/ui build",
  "outputDirectory": "ui/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://paperclip-2vjw.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

